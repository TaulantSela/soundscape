{
  "name": "@soundscape/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for Soundscape Mixer.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@soundscape/audio-library": "file:../../packages/audio-library",
    "argon2": "^0.40.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.7",
    "@types/node": "^22.18.0",
    "@types/cors": "^2.8.17",
    "prisma": "^5.19.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "5.5.4",
    "vitest": "^5.1.0"
  }
}
