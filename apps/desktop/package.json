{
  "name": "@soundscape/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Soundscape Mixer: the web mixer plus tray controls.",
  "author": "Taulant Sela <taulant1995@gmail.com>",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && cross-env NODE_ENV=development electron .",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "lint": "eslint 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@soundscape/config": "file:../../packages/config"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "cross-env": "^7.0.3",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "typescript": "5.5.4"
  },
  "build": {
    "appId": "com.taulantsela.soundscape",
    "productName": "Soundscape Mixer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "electronVersion": "45.2.3"
  }
}
